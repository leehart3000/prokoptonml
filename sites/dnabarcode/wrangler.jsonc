// dnabarcode.org: the website (static files in public/) and a small API
// gateway (src/index.js) in front of the dnabarcode Cloud Run service.
// Deploy from the repository root:
//   npx --yes wrangler@4.162.0 deploy --config sites/dnabarcode/wrangler.jsonc
{
  "name": "dnabarcode-site",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // Only the custom domain serves the site (no workers.dev or preview URLs)
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dnabarcode.org", "custom_domain": true }],
  // Static files are served directly; only /api/* runs the Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Not secret. Secrets (API_KEY, TURNSTILE_SECRET) are set with
  // `wrangler secret put` and never stored in the repository.
  "vars": {
    "API_URL": "https://dnabarcode-api-bb2c2tivta-nw.a.run.app",
    "EXPECTED_HOSTNAME": "dnabarcode.org",
    "TURNSTILE_ACTION": "identify"
  },
  // Per visitor (IP address), per Cloudflare location
  "ratelimits": [
    { "name": "IDENTIFY_LIMITER", "namespace_id": "2101", "simple": { "limit": 10, "period": 60 } },
    { "name": "HEALTH_LIMITER", "namespace_id": "2102", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
