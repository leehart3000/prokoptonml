# Deploy settings for the dnabarcode service. Nothing here is secret: the
# API key is in Secret Manager and CI signs in with Workload Identity
# Federation. Read by .github/workflows/deploy-dnabarcode.yml.
PROJECT_ID=prokoptonml
REGION=europe-west2
WIF_PROVIDER=projects/15697199549/locations/global/workloadIdentityPools/github/providers/prokoptonml-main
DEPLOYER_SA=github-deployer@prokoptonml.iam.gserviceaccount.com
IMAGE=europe-west2-docker.pkg.dev/prokoptonml/prokoptonml/dnabarcode-api
SERVICE=dnabarcode-api
RUNTIME_SA=dnabarcode-api@prokoptonml.iam.gserviceaccount.com
SECRET=dnabarcode-api-key
# The serving bundle to build into the image (one dated folder per bundle)
BUNDLE=gs://prokoptonml-bundles/dnabarcode/2026-11-12
# Cloud Run limits: scale to zero, at most 2 instances, so costs stay small
CPU=1
MEMORY=2Gi
CONCURRENCY=4
MAX_INSTANCES=2
TIMEOUT=120
